# ============================================================================
# Collective Access SaaS Backend - Environment Configuration
# Copy this file to .env and fill in all <PLACEHOLDER> values
# ============================================================================

# Database
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>

# Stripe
STRIPE_SECRET_KEY=<STRIPE_SECRET_KEY>
STRIPE_PUBLISHABLE_KEY=<STRIPE_PUBLISHABLE_KEY>
STRIPE_WEBHOOK_SECRET=<STRIPE_WEBHOOK_SECRET>

# Kubernetes
KUBERNETES_IN_CLUSTER=false
HELM_CHART_PATH=../k8s/helm/collectiveaccess

# Domain
BASE_DOMAIN=<YOUR_DOMAIN>

# MySQL (shared CA database)
DB_HOST=mysql.ca-system.svc.cluster.local
DB_PORT=3306
DB_USER=<MYSQL_USER>
DB_PASSWORD=<MYSQL_PASSWORD>
MYSQL_ROOT_PASSWORD=<MYSQL_ROOT_PASSWORD>

# Collective Access
CA_ADMIN_EMAIL=<CA_ADMIN_EMAIL>
CA_TIMEZONE=<CA_TIMEZONE>
CA_DOCKER_IMAGE=<CA_DOCKER_IMAGE>
CA_CERT_ISSUER=letsencrypt
CA_STORAGE_SIZE=20Gi

# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=<SECRET_KEY>

# Application
DEBUG=false
APP_URL=https://<YOUR_DOMAIN>

# CA Agent
OLLAMA_URL=http://ollama.ca-system.svc.cluster.local:11434
OLLAMA_MODEL=llama3.2:1b
CA_URL=http://collectiveaccess.ca-system.svc.cluster.local
CA_USERNAME=<CA_ADMIN_USERNAME>
CA_PASSWORD=<CA_ADMIN_PASSWORD>
ALLOWED_ORIGINS=https://<YOUR_PORTAL_DOMAIN>
CA_AGENT_URL=http://ca-agent.ca-system.svc.cluster.local:8001
